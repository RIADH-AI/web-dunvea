<section class="section-spacing" style="--pt: 64px; --pb: 112px;">
  <div class="page-width">
    <header class="section-header section-header--center"><h1 class="h1">{{ section.settings.heading }}</h1></header>
    <ul class="product-grid product-grid--3" role="list">
      {%- for c in collections -%}
        {%- unless c.handle == 'frontpage' -%}
          <li>
            <div class="card">
              <a href="{{ c.url }}" class="card__media ratio ratio--{{ settings.card_image_ratio }}" tabindex="-1" aria-hidden="true">
                {%- assign c_image = c.featured_image | default: c.products.first.featured_media -%}
                {%- if c_image != blank -%}
                  {{ c_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 500, 700, 1000', sizes: '(min-width: 750px) 33vw, 50vw', class: 'card__image', alt: '' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </a>
              <div class="card__info">
                <h2 class="card__title"><a href="{{ c.url }}" class="card__link">{{ c.title | escape }}</a></h2>
                <p class="card__options">{{ 'collections.count' | t: count: c.products_count }}</p>
              </div>
            </div>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "tag": "div",
  "settings": [ { "type": "text", "id": "heading", "label": "Titre", "default": "Collections" } ]
}
{% endschema %}
