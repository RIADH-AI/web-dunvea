<section class="section-spacing" style="--pt: 64px; --pb: 112px;">
  <div class="page-width">
    <header class="page-header"><h1 class="h1">{{ 'general.search.title' | t }}</h1></header>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label for="SearchInput" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
      <input class="input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="center-block" style="margin-bottom: 2.5rem;">{{ 'general.search.results' | t: count: search.results_count, terms: search.terms }}</p>
        {%- if search.results_count > 0 -%}
          <ul class="product-grid product-grid--4" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {%- render 'product-card', product: item, heading_tag: 'h2' -%}
                {%- else -%}
                  <div class="card">
                    <div class="card__info">
                      <h2 class="card__title"><a href="{{ item.url }}" class="card__link">{{ item.title | escape }}</a></h2>
                      <p class="card__options">{{ item.content | strip_html | truncatewords: 20 }}</p>
                    </div>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <nav aria-label="{{ 'general.pagination.label' | t }}"><div class="pagination">{{ paginate | default_pagination }}</div></nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Recherche", "tag": "div", "settings": [] }
{% endschema %}
