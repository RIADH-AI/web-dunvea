{%- comment -%} « Vous aimerez aussi » — recommandations Shopify (chargées en différé). {%- endcomment -%}
<product-recommendations
  class="recommendations section-spacing bg-{{ section.settings.background }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <header class="section-header section-header--split">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </header>
      <ul class="product-grid product-grid--{{ section.settings.products_to_show }}" role="list">
        {%- for rec in recommendations.products -%}
          <li>{%- render 'product-card', product: rec -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Vous aimerez aussi",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "intent", "label": "Type de recommandation", "default": "related", "options": [ { "value": "related", "label": "Produits similaires" }, { "value": "complementary", "label": "Produits complémentaires" } ] },
    { "type": "select", "id": "background", "label": "Fond", "default": "blanc", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
