{%- comment -%} « Deux bois » — présentation Frêne / Acajou. {%- endcomment -%}
<section id="bois" class="section-spacing bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <header class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte section-header__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <div class="woods">
      {%- for block in section.blocks -%}
        <article class="wood-card reveal" {{ block.shopify_attributes }}>
          <div class="wood-card__media ratio ratio--landscape">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.image.alt }}
            {%- else -%}
              <div class="placeholder" style="background: {{ block.settings.swatch }}; opacity: 1;"></div>
            {%- endif -%}
          </div>
          <h3 class="wood-card__title h3"><span class="wood-card__swatch" style="--swatch: {{ block.settings.swatch }};" aria-hidden="true"></span>{{ block.settings.name }}</h3>
          {%- if block.settings.text != blank -%}<p class="wood-card__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- assign traits = block.settings.traits | split: ',' -%}
          {%- if traits.size > 0 -%}
            <ul class="wood-card__traits">
              {%- for trait in traits -%}<li class="badge">{{ trait | strip }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Deux bois",
  "tag": "div",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "wood",
      "name": "Bois",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Frêne massif" },
        { "type": "color", "id": "swatch", "label": "Couleur", "default": "#D9B98C" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "traits", "label": "Caractéristiques (séparées par des virgules)", "default": "Clair, Grain fin, Très résistant" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Deux bois" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Clair ou profond, toujours massif" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "select", "id": "background", "label": "Fond", "default": "beige", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "presets": [ { "name": "Deux bois", "blocks": [ { "type": "wood" }, { "type": "wood" } ] } ]
}
{% endschema %}
