{%- liquid
  assign fc = section.settings.collection | default: collections.all
  assign limit = section.settings.products_to_show
-%}
<section class="section-spacing bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <header class="section-header{% if section.settings.center %} section-header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte section-header__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
      {%- if fc != blank and fc.products_count > 0 -%}
        {%- for product in fc.products limit: limit -%}
          <li class="reveal">{%- render 'product-card', product: product -%}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li>
            <div class="card">
              <div class="card__media ratio ratio--{{ settings.card_image_ratio }}">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
              <div class="card__info"><p class="card__title">{{ 'general.placeholder_product' | t }}</p></div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.button_label != blank and fc.url != blank -%}
      <div class="featured-collection__footer">
        <a href="{{ fc.url }}" class="button button--secondary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection mise en avant",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La collection" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quatre pièces, deux bois" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Vide : tous les produits." },
    { "type": "range", "id": "products_to_show", "label": "Produits affichés", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Colonnes (desktop)", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "checkbox", "id": "center", "label": "Titre centré", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir toute la collection" },
    { "type": "select", "id": "background", "label": "Fond", "default": "beige", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "presets": [ { "name": "Collection mise en avant" } ]
}
{% endschema %}
