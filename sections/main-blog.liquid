{%- paginate blog.articles by 9 -%}
<section class="section-spacing" style="--pt: 64px; --pb: 112px;">
  <div class="page-width">
    <header class="section-header section-header--center"><h1 class="h1">{{ blog.title | escape }}</h1></header>
    <ul class="product-grid product-grid--3" role="list">
      {%- for article in blog.articles -%}
        <li>
          <div class="card">
            <a href="{{ article.url }}" class="card__media ratio ratio--landscape" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 750px) 33vw, 100vw', class: 'card__image', alt: '' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </a>
            <div class="card__info">
              <p class="card__options">{{ article.published_at | date: format: 'date' }}</p>
              <h2 class="card__title"><a href="{{ article.url }}" class="card__link">{{ article.title | escape }}</a></h2>
              <p class="card__options">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav aria-label="{{ 'general.pagination.label' | t }}"><div class="pagination">{{ paginate | default_pagination }}</div></nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "div", "settings": [] }
{% endschema %}
