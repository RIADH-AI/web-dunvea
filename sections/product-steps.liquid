{%- comment -%} Installation — étapes numérotées, avec image et mention finale. {%- endcomment -%}
<section id="{{ section.settings.anchor | default: 'installation' }}" class="steps section-spacing bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="steps__layout{% if section.settings.image != blank %} steps__layout--media{% endif %}">
      <div class="steps__content">
        <header class="section-header">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.intro != blank -%}<div class="rte section-header__intro">{{ section.settings.intro }}</div>{%- endif -%}
        </header>

        <ol class="steps__list" role="list">
          {%- for block in section.blocks -%}
            <li class="steps__item" {{ block.shopify_attributes }}>
              <span class="steps__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                {%- if block.settings.title != blank -%}<h3 class="steps__title">{{ block.settings.title }}</h3>{%- endif -%}
                {%- if block.settings.text != blank -%}<p class="steps__text">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>

        {%- if section.settings.note != blank -%}
          <div class="steps__note">{% render 'icon', icon: 'clock', size: 20 %}<div class="rte">{{ section.settings.note }}</div></div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="steps__media ratio ratio--portrait">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.image.alt }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produit — installation",
  "tag": "div",
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "installation" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Installation" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Dix minutes, une perceuse, un niveau." },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "richtext", "id": "note", "label": "Mention finale" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "background", "label": "Fond", "default": "beige", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Étapes numérotées", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
