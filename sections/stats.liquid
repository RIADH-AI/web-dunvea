<section class="section-spacing bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section-header section-header--center"><h2 class="h2">{{ section.settings.heading }}</h2></header>
    {%- endif -%}
    <ul class="stats" role="list" style="--stats-count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="reveal" {{ block.shopify_attributes }}>
          <span class="stats__value">{{ block.settings.value }}</span>
          <span class="stats__label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Chiffres clés",
  "tag": "div",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre",
      "settings": [
        { "type": "text", "id": "value", "label": "Valeur", "default": "100 %" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "bois massif" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "select", "id": "background", "label": "Fond", "default": "blanc", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [ { "name": "Chiffres clés", "blocks": [ { "type": "stat" }, { "type": "stat" }, { "type": "stat" } ] } ]
}
{% endschema %}
