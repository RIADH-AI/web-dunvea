<section class="password">
  <div class="password__inner">
    <span class="logo-text">{{ settings.logo_text | default: shop.name }}</span>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form">
          <label for="PasswordEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required>
          <button type="submit" aria-label="{{ 'newsletter.button' | t }}">{% render 'icon', icon: 'arrow-right', size: 20 %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top: 3rem;">
      <summary class="link-button">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field" style="margin-top: 1rem;">
          <label for="StorePassword">{{ 'password.label' | t }}</label>
          <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password">
        </div>
        <button type="submit" class="button button--full">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'atelier prépare l'ouverture" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Étagères flottantes et miroirs organiques en bois massif. Laissez votre e-mail, nous vous prévenons à l'ouverture.</p>" }
  ]
}
{% endschema %}
