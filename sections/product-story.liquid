{%- comment -%}
  Description produit détaillée — chapitres empilés (texte + image en alternance).
  Sans bloc, affiche la description Shopify du produit.
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: 'description' }}" class="story section-spacing bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="story__chapters">
        {%- for block in section.blocks -%}
          {%- assign has_image = false -%}
          {%- if block.settings.image != blank or block.settings.show_placeholder -%}{%- assign has_image = true -%}{%- endif -%}
          <article class="story__chapter{% if has_image %} story__chapter--media{% endif %}{% cycle '', ' story__chapter--reverse' %}" {{ block.shopify_attributes }}>
            {%- if has_image -%}
              <div class="story__media ratio ratio--{{ block.settings.ratio }}">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: block.settings.image.alt }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="story__content">
              {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h3 class="h3">{{ block.settings.heading }}</h3>{%- endif -%}
              <div class="rte rte--large">{{ block.settings.text }}</div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif product.description != blank -%}
      <div class="story__description rte rte--large">{{ product.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produit — description",
  "tag": "div",
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapitre",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "richtext", "id": "text", "label": "Texte" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "show_placeholder", "label": "Afficher un visuel provisoire sans image", "default": false },
        { "type": "select", "id": "ratio", "label": "Format de l'image", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Carré" }, { "value": "landscape", "label": "Paysage" } ] }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "description" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre de section" },
    { "type": "select", "id": "background", "label": "Fond", "default": "beige", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Produit — description", "blocks": [ { "type": "chapter" } ] } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
