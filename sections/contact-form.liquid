<section class="section-spacing bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--narrow">
    <div class="contact">
      <aside class="contact__aside">
        <header class="section-header">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<div class="rte section-header__intro">{{ section.settings.text }}</div>{%- endif -%}
        </header>
        {%- for block in section.blocks -%}
          <div class="contact__info" {{ block.shopify_attributes }}>
            {%- render 'icon', icon: block.settings.icon, size: 22 -%}
            <div>
              <p class="contact__info-title">{{ block.settings.title }}</p>
              <div class="contact__info-text rte">{{ block.settings.text }}</div>
            </div>
          </div>
        {%- endfor -%}
      </aside>

      <div class="contact__form">
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message" role="status" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="contact__form-row">
            <div class="field">
              <label for="ContactName">{{ 'contact.name' | t }}</label>
              <input class="input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name }}">
            </div>
            <div class="field">
              <label for="ContactEmail">{{ 'contact.email' | t }} *</label>
              <input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | default: customer.email }}">
            </div>
          </div>
          <div class="contact__form-row">
            <div class="field">
              <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
              <input class="input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field">
              <label for="ContactOrder">{{ 'contact.order' | t }}</label>
              <input class="input" id="ContactOrder" type="text" name="contact[order]" value="{{ form.order }}">
            </div>
          </div>
          <div class="field">
            <label for="ContactSubject">{{ 'contact.subject' | t }}</label>
            <select class="select input" id="ContactSubject" name="contact[subject]">
              <option>{{ 'contact.subjects.product' | t }}</option>
              <option>{{ 'contact.subjects.order' | t }}</option>
              <option>{{ 'contact.subjects.return' | t }}</option>
              <option>{{ 'contact.subjects.pro' | t }}</option>
              <option>{{ 'contact.subjects.other' | t }}</option>
            </select>
          </div>
          <div class="field">
            <label for="ContactBody">{{ 'contact.message' | t }} *</label>
            <textarea class="textarea" id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button button--full">{{ 'contact.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "tag": "div",
  "blocks": [
    {
      "type": "info",
      "name": "Information",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "mail", "options": [ { "value": "mail", "label": "E-mail" }, { "value": "phone", "label": "Téléphone" }, { "value": "clock", "label": "Horaires" }, { "value": "pin", "label": "Adresse" }, { "value": "instagram", "label": "Instagram" } ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "E-mail" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>bonjour@dunvea.com</p>" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "select", "id": "background", "label": "Fond", "default": "beige", "options": [ { "value": "beige", "label": "Beige" }, { "value": "blanc", "label": "Blanc" } ] },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "presets": [ { "name": "Formulaire de contact", "blocks": [ { "type": "info" } ] } ]
}
{% endschema %}
