{%- comment -%}
  Fil d'Ariane : Accueil → Collection → Produit (+ JSON-LD BreadcrumbList).
{%- endcomment -%}
{%- liquid
  assign crumb_collection = collection
  if request.page_type == 'product' and crumb_collection == blank
    for c in product.collections
      unless c.handle == 'all' or c.handle == 'frontpage'
        assign crumb_collection = c
        break
      endunless
    endfor
  endif
-%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    </li>
    {%- case request.page_type -%}
      {%- when 'product' -%}
        {%- if crumb_collection != blank -%}
          <li class="breadcrumbs__item"><a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a></li>
        {%- endif -%}
        <li class="breadcrumbs__item" aria-current="page">{{ product.title }}</li>
      {%- when 'collection' -%}
        <li class="breadcrumbs__item" aria-current="page">{{ collection.title }}</li>
      {%- when 'page' -%}
        <li class="breadcrumbs__item" aria-current="page">{{ page.title }}</li>
      {%- when 'blog' -%}
        <li class="breadcrumbs__item" aria-current="page">{{ blog.title }}</li>
      {%- when 'article' -%}
        <li class="breadcrumbs__item"><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li class="breadcrumbs__item" aria-current="page">{{ article.title }}</li>
    {%- endcase -%}
  </ol>
</nav>

{%- liquid
  assign pos = 1
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home' | t | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      }
      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if crumb_collection != blank -%}
            {%- assign pos = pos | plus: 1 -%}
            ,{
              "@type": "ListItem",
              "position": {{ pos }},
              "name": {{ crumb_collection.title | json }},
              "item": {{ request.origin | append: crumb_collection.url | json }}
            }
          {%- endif -%}
          {%- assign pos = pos | plus: 1 -%}
          ,{
            "@type": "ListItem",
            "position": {{ pos }},
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- when 'collection' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
        {%- when 'page' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ request.origin | append: page.url | json }} }
        {%- when 'blog' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} }
        {%- when 'article' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
      {%- endcase -%}
    ]
  }
</script>
