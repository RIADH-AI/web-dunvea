{%- comment -%} Champs d'adresse client. Paramètres : form, prefix {%- endcomment -%}
<div style="margin-top: 1.5rem;">
  <div class="field"><label for="AddrFirst-{{ prefix }}">{{ 'customer.first_name' | t }}</label><input class="input" id="AddrFirst-{{ prefix }}" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
  <div class="field"><label for="AddrLast-{{ prefix }}">{{ 'customer.last_name' | t }}</label><input class="input" id="AddrLast-{{ prefix }}" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
  <div class="field"><label for="AddrAddress1-{{ prefix }}">{{ 'customer.addresses.address1' | t }}</label><input class="input" id="AddrAddress1-{{ prefix }}" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
  <div class="field"><label for="AddrAddress2-{{ prefix }}">{{ 'customer.addresses.address2' | t }}</label><input class="input" id="AddrAddress2-{{ prefix }}" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
  <div class="field"><label for="AddrZip-{{ prefix }}">{{ 'customer.addresses.zip' | t }}</label><input class="input" id="AddrZip-{{ prefix }}" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
  <div class="field"><label for="AddrCity-{{ prefix }}">{{ 'customer.addresses.city' | t }}</label><input class="input" id="AddrCity-{{ prefix }}" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
  <div class="field">
    <label for="AddrCountry-{{ prefix }}">{{ 'customer.addresses.country' | t }}</label>
    <select class="select input" id="AddrCountry-{{ prefix }}" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select>
  </div>
  <div class="field"><label for="AddrPhone-{{ prefix }}">{{ 'contact.phone' | t }}</label><input class="input" id="AddrPhone-{{ prefix }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
  <p style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem; font-size: 0.9rem;">
    {{ form.set_as_default_checkbox }}
    <label for="address_default_address_{{ form.id }}">{{ 'customer.addresses.set_default' | t }}</label>
  </p>
</div>
