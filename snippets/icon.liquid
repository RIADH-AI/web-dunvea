{%- comment -%}
  Icônes SVG en ligne (trait fin, 1.5px).
  Usage : {% render 'icon', icon: 'truck' %}  — option : size (px)
{%- endcomment -%}
{%- assign size = size | default: 24 -%}
{%- capture attrs -%}
  class="icon icon-{{ icon }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
{%- endcapture -%}
{%- case icon -%}
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>
  {%- when 'return' -%}
    <svg {{ attrs }}><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/></svg>
  {%- when 'wood' -%}
    <svg {{ attrs }}><ellipse cx="12" cy="12" rx="9" ry="9"/><ellipse cx="12" cy="12" rx="6" ry="5.6"/><ellipse cx="12" cy="12" rx="3" ry="2.6"/><path d="M12 3v3.4"/></svg>
  {%- when 'hand' -%}
    <svg {{ attrs }}><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M11 10V4.5a1.5 1.5 0 0 1 3 0V11"/><path d="M14 10.5V6a1.5 1.5 0 0 1 3 0v7"/><path d="M8 12.5 6.6 11a1.6 1.6 0 0 0-2.4 2.1l3.3 4.3A7 7 0 0 0 13 20.5h.5a5 5 0 0 0 5-5V13"/></svg>
  {%- when 'shield' -%}
    <svg {{ attrs }}><path d="M12 3 5 6v5.5c0 4.3 3 7.7 7 9.5 4-1.8 7-5.2 7-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'ruler' -%}
    <svg {{ attrs }}><path d="M3 16.5 16.5 3 21 7.5 7.5 21z"/><path d="m7 12.5 1.5 1.5M9.5 10l2 2M12 7.5l1.5 1.5M14.5 5l2 2"/></svg>
  {%- when 'leaf' -%}
    <svg {{ attrs }}><path d="M5 19C5 10 10 5 20 4c-1 10-6 15-15 15z"/><path d="M5 19 13 11"/></svg>
  {%- when 'drill' -%}
    <svg {{ attrs }}><path d="M3 7h11v5H3z"/><path d="M14 8.5h4M18 9.5h3"/><path d="M6 12l-1 8h4l1-8"/></svg>
  {%- when 'box' -%}
    <svg {{ attrs }}><path d="m3 7.5 9-4.5 9 4.5v9L12 21l-9-4.5z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg>
  {%- when 'mail' -%}
    <svg {{ attrs }}><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
  {%- when 'phone' -%}
    <svg {{ attrs }}><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/></svg>
  {%- when 'pin' -%}
    <svg {{ attrs }}><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
  {%- when 'clock' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
  {%- when 'cart' -%}
    <svg {{ attrs }}><path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
  {%- when 'account' -%}
    <svg {{ attrs }}><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.2-6 8-6s7 2 8 6"/></svg>
  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M3 7h18M3 12h18M3 17h18"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }}><path d="M5 5l14 14M19 5 5 19"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ attrs }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-right' -%}
    <svg {{ attrs }}><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'chevron-left' -%}
    <svg {{ attrs }}><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ attrs }}><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  {%- when 'plus' -%}
    <svg {{ attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg {{ attrs }}><path d="M5 12h14"/></svg>
  {%- when 'check' -%}
    <svg {{ attrs }}><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'zoom' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5M11 8v6M8 11h6"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon-star" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/></svg>
  {%- when 'instagram' -%}
    <svg {{ attrs }}><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/></svg>
  {%- when 'pinterest' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M10.5 20.5 12.5 12M10 13.5c-1-3 .5-6 3.5-6 2.5 0 3.5 2 3 4-.5 2.5-2.5 3.5-4 2.5"/></svg>
  {%- when 'tiktok' -%}
    <svg {{ attrs }}><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.8 2.4 4.5 5 4.7"/></svg>
  {%- when 'facebook' -%}
    <svg {{ attrs }}><path d="M14.5 21v-8h2.7l.4-3.2h-3.1V7.9c0-.9.3-1.6 1.6-1.6h1.6V3.5a22 22 0 0 0-2.4-.1c-2.4 0-4 1.4-4 4.1v2.3H8.6V13h2.7v8"/></svg>
