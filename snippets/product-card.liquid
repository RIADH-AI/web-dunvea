{%- comment -%}
  Carte produit.
  Paramètres : product (obligatoire), sizes (attribut sizes), heading_tag (défaut h3), lazy (défaut true)
{%- endcomment -%}
{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign card_alt = product.featured_media.alt | default: product.title
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="card">
  <a href="{{ product.url }}" class="card__media ratio ratio--{{ settings.card_image_ratio }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 1200 | image_tag:
        widths: '300, 450, 600, 800, 1000, 1200',
        sizes: sizes,
        loading: loading,
        class: 'card__image card__image--primary',
        alt: card_alt
      }}
      {%- if settings.card_show_secondary_image and product.media[1] != blank -%}
        {{ product.media[1] | image_url: width: 1200 | image_tag:
          widths: '300, 450, 600, 800, 1000, 1200',
          sizes: sizes,
          loading: 'lazy',
          class: 'card__image card__image--secondary',
          alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder card__image' }}
    {%- endif -%}
    {%- if on_sale -%}
      <span class="badge badge--accent card__badge">{{ 'products.product.badge_bundle' | t }}</span>
    {%- endif -%}
  </a>
  <div class="card__info">
    <{{ heading_tag }} class="card__title">
      <a href="{{ product.url }}" class="card__link">{{ product.title | escape }}</a>
    </{{ heading_tag }}>
    {%- if settings.card_show_rating -%}
      {%- render 'star-rating', product: product -%}
    {%- endif -%}
    {%- if product.options_by_name['Bois'] -%}
      <p class="card__options">{{ product.options_by_name['Bois'].values | join: ' · ' }}</p>
    {%- endif -%}
    {%- render 'price', product: product -%}
  </div>
</div>
