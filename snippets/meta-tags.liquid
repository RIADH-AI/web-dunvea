{%- comment -%}
  Balises <title>, meta description, Open Graph et Twitter.
  Le title et la meta description viennent des champs SEO de Shopify
  (Produit > « Référencement sur les moteurs de recherche »).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  assign title_down = page_title | downcase
  assign shop_down = shop.name | downcase

  if request.page_type == 'product'
    assign og_type = 'product'
    assign price_cents = product.price | modulo: 100 | prepend: '0' | slice: -2, 2
    assign price_units = product.price | divided_by: 100
    assign og_price = price_units | append: '.' | append: price_cents
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<title>
  {{- page_title -}}
  {%- if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless title_down contains shop_down %} | {{ shop.name }}{% endunless -%}
</title>
{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="fr_FR">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ og_price }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
