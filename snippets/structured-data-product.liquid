{%- comment -%}
  JSON-LD Product (données structurées Google).
  - name, description, image, brand DUNVEA, sku
  - offers : une offre par variante (Frêne / Acajou), prix en EUR, disponibilité
  - shippingDetails (livraison offerte France) + hasMerchantReturnPolicy (retours)
  - aggregateRating uniquement si des avis existent (métachamps reviews.*)
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign description = page_description | default: product.description | strip_html | strip_newlines | truncate: 5000
  assign seo_name = product.metafields.custom.h1.value | default: product.title
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "@id": {{ request.origin | append: product.url | append: '#product' | json }},
    "name": {{ seo_name | json }},
    "url": {{ request.origin | append: product.url | json }},
    "description": {{ description | json }},
    {%- if product.media.size > 0 %}
    "image": [
      {%- for media in product.media limit: 6 -%}
        {%- if media.preview_image -%}
          {{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
    ],
    {%- endif %}
    "brand": { "@type": "Brand", "name": "DUNVEA" },
    {%- if product.selected_or_first_available_variant.sku != blank %}
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "material": {{ product.options_by_name['Bois'].values | default: product.options_by_name['Matériau'].values | join: ', ' | default: 'Bois massif' | json }},
    {%- if rating != blank and rating_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating.rating | json }},
      "bestRating": {{ rating.scale_max | default: 5 | json }},
      "worstRating": {{ rating.scale_min | default: 1 | json }},
      "reviewCount": {{ rating_count | json }}
    },
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign cents = variant.price | modulo: 100 | prepend: '0' | slice: -2, 2
          assign units = variant.price | divided_by: 100
          assign variant_price = units | append: '.' | append: cents
        -%}
        {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
          {%- if variant.barcode.size == 13 %}"gtin13": {{ variant.barcode | json }},{% elsif variant.barcode.size == 12 %}"gtin12": {{ variant.barcode | json }},{% endif %}
          "url": {{ request.origin | append: variant.url | json }},
          "price": {{ variant_price | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "seller": { "@type": "Organization", "name": "DUNVEA" }
          {%- if settings.schema_free_shipping -%}
          ,"shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0.00", "currency": "EUR" },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "FR" }
          }
          {%- endif -%}
          {%- if settings.schema_return_days > 0 -%}
          ,"hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "FR",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ settings.schema_return_days }},
            "returnMethod": "https://schema.org/ReturnByMail"
          }
          {%- endif -%}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
